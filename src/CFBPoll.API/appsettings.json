{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cfbpoll-.log",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*",
  "CollegeFootballData": {
    "ApiKey": ""
  },
  "HistoricalData": {
    "MinimumYear": 2002
  },
  "BettingLines": {
    "PreferredProvider": "Bovada"
  },
  "Cache": {
    "ConnectionString": "Data Source=data/cache.db",
    "SeasonDataExpirationHours": 24,
    "CalendarExpirationHours": 168,
    "MaxSeasonYearExpirationHours": 24,
    "SeasonBoundaryGraceMonth": 3,
    "SeasonBoundaryGraceDay": 1,
    "CleanupIntervalMinutes": 60,
    "CleanupStartupDelayMinutes": 5
  },
  "Database": {
    "ConnectionString": "Data Source=data/cfbpoll.db"
  }
}
